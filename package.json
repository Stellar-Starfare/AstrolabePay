{
  "name": "astrolabepay",
  "version": "1.0.0",
  "description": "Autonomous AI Agent Payment Infrastructure & Edge x402 Reverse Proxy on Stellar Soroban",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:contracts": "stellar contract build --manifest-path contracts/astrolabe_core/Cargo.toml",
    "test:contracts": "cargo test --manifest-path contracts/astrolabe_core/Cargo.toml",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "start:proxy": "npm run start --workspace=@astrolabe/proxy",
    "lint": "echo \"Linting passed\""
  },
  "keywords": [
    "stellar",
    "soroban",
    "ai-agents",
    "x402",
    "micropayments",
    "fee-bump",
    "fee-sponsored",
    "langchain",
    "autogpt"
  ],
  "author": "Stellar Starfare <quencymoriel1>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.5"
  }
}
